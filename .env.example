# Copy this file to `.env` and adjust values for your machine:
#   cp .env.example .env

# --- TenantFlow API -------------------------------------------------------------
TENANTFLOW_ENV=development
TENANTFLOW_HTTP_PORT=9090


# --- PostgreSQL -------------------------------------------------------------
# `POSTGRESQL_VERSION` is the image tag; the others match the variable names
# referenced inside docker-compose.yml. Do NOT rename without changing compose.
POSTGRESQL_VERSION=16
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
# Host port mapped to Postgres' internal 5432 (5432 is often taken on hosts)
POSTGRES_PORT=5433

# --- Temporal ---------------------------------------------------------------
TEMPORAL_VERSION=1.31.0
TEMPORAL_PORT=7233

# Space-separated list of namespaces registered on startup, e.g.:
#   TEMPORAL_NAMESPACES=default qa staging
TEMPORAL_NAMESPACES=default

# --- Temporal UI ------------------------------------------------------------
TEMPORAL_UI_VERSION=2.49.1
TEMPORAL_UI_PORT=8080

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_VERSION=26.7.0
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
