{
  "title": "TenantFlow",
  "uid": "tenantflow-overview",
  "tags": ["tenantflow"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s"] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Provision time (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "unit": "s",
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(temporal_workflow_endtoend_latency_bucket{workflow_type=\"ProvisionTenantWorkflow\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Provision outcomes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(temporal_workflow_completed{workflow_type=\"ProvisionTenantWorkflow\"}[$__rate_interval])", "legendFormat": "completed" },
        { "refId": "B", "expr": "rate(temporal_workflow_failed{workflow_type=\"ProvisionTenantWorkflow\"}[$__rate_interval])", "legendFormat": "failed" },
        { "refId": "C", "expr": "rate(temporal_workflow_canceled{workflow_type=\"ProvisionTenantWorkflow\"}[$__rate_interval])", "legendFormat": "canceled" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Activity executions by result",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(tenantflow_activity_executions_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Compensation rollbacks",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (activity) (tenantflow_activity_executions_total{activity=~\"DropTenantDatabase|DropTenantAuxDatabase|RollbackQuotas|RestoreRollback\"})",
          "legendFormat": "{{activity}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP requests by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(tenantflow_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker pollers",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line" } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "temporal_num_pollers",
          "legendFormat": "{{task_queue}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Monthly cost per tenant",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "$", "custom": { "align": "left", "displayMode": "auto" } },
        "overrides": []
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Value", "desc": true }] },
      "targets": [
        {
          "refId": "A",
          "expr": "tenantflow_tenant_monthly_cost_dollars",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Total monthly cost (all tenants)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "$" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(tenantflow_tenant_monthly_cost_dollars)"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}